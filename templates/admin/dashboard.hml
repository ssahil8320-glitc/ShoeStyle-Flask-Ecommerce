{% extends "base.html" %}{% block title %}Admin Dashboard | ShoeStyle{% endblock %}{% block content %}<section class="admin-heading"><div><span class="eyebrow">STORE CONTROL CENTRE</span><h1>Admin <em>dashboard.</em></h1></div><a class="btn btn-dark" href="{{ url_for('product_form') }}">+ Add product</a></section><section class="section admin-section"><div class="stats-grid"><div class="stat-card"><span>Total products</span><strong>{{ product_count }}</strong></div><div class="stat-card"><span>Total orders</span><strong>{{ order_count }}</strong></div><div class="stat-card"><span>Order value</span><strong>₹{{ "{:,}".format(revenue) }}</strong></div></div><div class="admin-table-wrap"><h2>Products</h2><table><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr></thead><tbody>{% for p in products %}<tr><td>{{ p.name }}</td><td>{{ p.category }}</td><td>₹{{ p.price }}</td><td>{{ p.stock }}</td><td><a href="{{ url_for('product_form', product_id=p.id) }}">Edit</a><form class="inline-delete" method="post" action="{{ url_for('delete_product', product_id=p.id) }}" onsubmit="return confirm('Delete this product?')"><button>Delete</button></form></td></tr>{% else %}<tr><td colspan="5">No products.</td></tr>{% endfor %}</tbody></table></div><div class="admin-table-wrap"><h2>Recent orders</h2><table><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th><th>Update status</th></tr></thead><tbody>{% for order in orders %}<tr><td>#SS{{ "%05d"|format(order.id) }}</td><td>{{ order.customer_name }}<br><small>{{ order.email }}</small></td><td>₹{{ order.total }}</td><td>{{ order.status }}</td><td><form class="status-form" method="post" action="{{ url_for('update_order_status', order_id=order.id) }}"><select name="status">{% for s in ['Pending','Confirmed','Shipped','Delivered','Cancelled'] %}<option {% if order.status == s %}selected{% endif %}>{{ s }}</option>{% endfor %}</select><button class="btn btn-dark btn-small">Save</button></form></td></tr>{% else %}<tr><td colspan="5">No orders yet.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
